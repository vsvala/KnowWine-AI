# =============================================================================
# KnowWine AI — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the populated .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the Express server listens on.
# Optional — defaults to 3001 if unset.
PORT=

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# -----------------------------------------------------------------------------

# Connection string for the primary database.
# Required. Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Enables SSL on the database connection (rejectUnauthorized: false).
# Required for Neon in production; leave unset for local Docker Postgres.
# Values: true | false
DB_SSL=

# Connection string used in place of DATABASE_URL when NODE_ENV=test.
# Required for running the test suite.
TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
# GrapeMinds API (external wine data provider)
# -----------------------------------------------------------------------------

# Base URL of the GrapeMinds API.
# Required.
GRAPEMINDS_URL=

# API key sent as a Bearer token on requests to GrapeMinds.
# Required.
GRAPEMINDS_API_KEY=

# -----------------------------------------------------------------------------
# Redis (production only)
# -----------------------------------------------------------------------------

# Port of the Redis instance used for caching/rate limiting.
# Only read when NODE_ENV=production and REDIS_URL is not set.
# Optional — defaults to 6379.
REDIS_PORT=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret used to sign and verify JWT access tokens.
# Required — the app refuses to start without it.
SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
COOKIE_NAME=
